{
  "name": "simple-youtube",
  "description": "Simple YouTube is a lightweight extension that simplifies your YouTube experience by removing unnecessary clutter.",
  "private": true,
  "version": "3.3.0",
  "type": "module",
  "scripts": {
    "build": "wxt build && wxt build -b firefox",
    "dev": "wxt",
    "postinstall": "wxt prepare",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "wxt prepare && tsc --noEmit",
    "zip": "wxt zip && wxt zip -b firefox"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
