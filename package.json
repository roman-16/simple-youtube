{
  "name": "simple-youtube",
  "description": "Simple YouTube is a lightweight extension that simplifies your YouTube experience by removing unnecessary clutter.",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "build": "wxt build && wxt build -b firefox",
    "dev": "wxt",
    "postinstall": "wxt prepare",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "wxt prepare && tsc --noEmit",
    "zip": "wxt zip && wxt zip -b firefox"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
